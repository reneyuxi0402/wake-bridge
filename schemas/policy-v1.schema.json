{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wakebridge.dev/schemas/policy-v1.schema.json",
  "title": "Wake Bridge personal policy file v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policies"],
  "properties": {
    "schema_version": { "const": 1 },
    "policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "delivery"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
        "version": { "type": "integer", "minimum": 1 },
        "enabled": { "type": "boolean" },
        "order": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "match": { "type": "object" },
        "delivery": { "$ref": "#/$defs/delivery" },
        "batch": { "$ref": "#/$defs/batch" },
        "target": { "$ref": "#/$defs/target" },
        "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expires_after_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["immediate", "scheduled", "suppress"] },
        "scheduled_local_time": {
          "type": ["string", "null"],
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
        },
        "quiet_hours_policy": { "enum": ["defer", "bypass"] },
        "foreground_presence_policy": { "enum": ["defer", "bypass"] }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coalesce_by": { "type": "string", "minLength": 1, "maxLength": 256 },
        "max_events": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000 },
        "window_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 604800000 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attention_channel": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
